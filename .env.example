# Required for Vercel or any hosted deployment. Local JSON is only suitable for rehearsal.
MONGODB_URI=
MONGODB_DB=bgmi_broadcast

# Use a long random value in a deployment. A local secret file is generated if omitted.
SESSION_SECRET=
# Set true only behind HTTPS. Keep false for localhost development.
COOKIE_SECURE=false
# Set true when deployed behind a trusted HTTPS proxy such as Vercel.
TRUST_PROXY=false
PORT=3000
